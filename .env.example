# NEXUS: AI-Powered Financial Identity & Trust Network
# Environment Configuration Template

# -----------------------------------------------------------------------------
# Frontend: Supabase Client Configuration
# -----------------------------------------------------------------------------
# Find these in your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# -----------------------------------------------------------------------------
# Server-side Only: Google Gemma 4 (via Gemini API) & Server Config
# (CRITICAL: Never prefix with VITE_ to prevent leaking into client bundle)
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Google Gemini API Key used to access Gemma 4 open-weight model
GEMINI_API_KEY=your_gemini_api_key_here

# Open-Weight Gemma 4 Model Identifier (Preferred: gemma-4-26b-a4b-it, Alternative: gemma-4-31b-it)
GEMMA_MODEL=gemma-4-26b-a4b-it

# AI Provider Identifier
AI_PROVIDER=gemma

# Maximum AI request timeout in milliseconds
AI_REQUEST_TIMEOUT_MS=30000
